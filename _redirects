/merge-pdf          /merge-pdf.html         200
/split-pdf          /split-pdf.html         200
/convert-image      /convert-image.html     200
/qr-code            /qr-code.html           200
/video-to-mp3       /video-to-mp3.html      200
/about              /about.html             200
/privacy            /privacy.html           200
/terms              /terms.html             200
